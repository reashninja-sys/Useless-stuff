# Copy this to .env and fill in your details
# Never share this file — it contains your car credentials

CUPRA_USERNAME=your.email@example.com
CUPRA_PASSWORD=your_cupra_password
CUPRA_VIN=VSSZZZ...               # 17-char VIN from your car docs / MyCupra app

# Shared secret between the server and your Garmin widget.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Paste the SAME value into Garmin Connect -> Widget Settings -> Api Key
API_KEY=replace_me_with_a_random_string

# How often the Cupra API is polled (seconds). Default 5 min.
CACHE_TTL=300

# Port — leave as 5000 unless something else on your phone uses it
PORT=5000
