# Copy this to .env and fill in your details
# Never share this file — it contains your car credentials

CUPRA_USERNAME=your.email@example.com
CUPRA_PASSWORD=your_cupra_password
CUPRA_VIN=VSSZZZ...               # 17-char VIN — car docs, MyCupra app, or door jamb sticker

# Shared secret between the server and your Garmin widget.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Paste the SAME value into Garmin Connect -> Widget Settings -> Api Key
API_KEY=replace_me_with_a_random_string

# How often the Cupra API is polled (seconds). Default 5 min.
CACHE_TTL=300

# Port — leave as 5000 unless something else is already using it
PORT=5000

# Advanced: override if Garmin's proxy can't reach 0.0.0.0 for some reason
# BIND_HOST=127.0.0.1

# Advanced: override if VW Group changes the API base URL
# CUPRA_API_BASE=https://ola.prod.code.seat.cloud.vwgroup.com

# Advanced: pin a specific OAuth client_id instead of auto-trying all known ones
# CUPRA_CLIENT_ID=3c756d51-694f-4ef8-b2f4-c9f1f8e9d235
