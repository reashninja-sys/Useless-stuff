# Copy this to .env and fill in your details
# Never commit .env to git

CUPRA_USERNAME=your.email@example.com
CUPRA_PASSWORD=your_cupra_password
CUPRA_VIN=VSSZZZ...               # 17-char VIN from your car docs / MyCupra app

# How often the cache is refreshed (seconds). Default 5 min.
CACHE_TTL=300

# Port the server listens on
PORT=5000
